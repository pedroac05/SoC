# -------------------------------------------------------------------------- #
# Quartus Prime 20.1.1 Settings File
# Project: Taller3
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "21:40:00  NOVEMBER 13, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.1 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"

set_global_assignment -name TOP_LEVEL_ENTITY fpu_top
set_global_assignment -name SEARCH_PATH ej3_fpu/ip/vhdl/fp_div

# Archivos IP de Punto Flotante (Cyclone V @ 50 MHz)
set_global_assignment -name VHDL_FILE ej3_fpu/ip/vhdl/fp_add/dspba_library_package.vhd
set_global_assignment -name VHDL_FILE ej3_fpu/ip/vhdl/fp_add/dspba_library.vhd
set_global_assignment -name VHDL_FILE ej3_fpu/ip/vhdl/fp_add/fp_add.vhd
set_global_assignment -name VHDL_FILE ej3_fpu/ip/vhdl/fp_sub/fp_sub.vhd
set_global_assignment -name VHDL_FILE ej3_fpu/ip/vhdl/fp_mul/fp_mul.vhd
set_global_assignment -name VHDL_FILE ej3_fpu/ip/vhdl/fp_div/fp_div.vhd
set_global_assignment -name VHDL_FILE ej3_fpu/vhdl/src/fpu_top.vhd

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top